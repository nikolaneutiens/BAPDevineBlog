---
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class="pill" data-tag={tag} href={href}>{tag}</Element>

<style>
  .pill {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--tag-text);
    text-decoration: none;
    background: var(--tag-color);
    /* Each tag gets a border in a darker shade of its own colour. */
    border: 2px solid var(--tag-border, var(--tag-color));
    border-radius: 999px;
  }
</style>
