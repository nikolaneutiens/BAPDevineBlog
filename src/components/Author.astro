---
import { withBase } from '../lib/paths';
import { initials, member, type MemberId } from '../lib/team';

interface Props {
  id: MemberId;
  /** Link the name to the person on the team page. */
  linked?: boolean;
}

const { id, linked = false } = Astro.props;
const m = member(id);
const Element = linked ? 'a' : 'span';
---

<Element class="author" href={linked ? withBase(`/team/${m.id}/`) : undefined}>
  <span class="avatar" style={`--c: ${m.color}`} aria-hidden="true">{initials(m.name)}</span>
  <span class="name">{m.name}</span>
</Element>

<style>
  .author {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  a.author:hover .name {
    color: var(--accent);
  }

  .avatar {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--tag-text);
    background: var(--c);
    border-radius: 6px;
  }
</style>
