---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';

interface Props {
  /** The next older post. */
  previous?: CollectionEntry<'blog'>;
  /** The next newer post. */
  next?: CollectionEntry<'blog'>;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav aria-label="More posts">
      {previous && <a href={withBase(`/blog/${previous.id}/`)}>← Previous post</a>}
      {next && <a class="next" href={withBase(`/blog/${next.id}/`)}>Next post →</a>}
    </nav>
  )
}

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  nav {
    padding-top: 2rem;
    border-top: 2px solid var(--border);
  }

  a {
    padding: 0.7rem 1.3rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    background: var(--surface);
    border-radius: 999px;
    box-shadow: var(--shadow);
    transition:
      transform 150ms,
      color 150ms;
  }

  .next {
    margin-left: auto;
  }

  @media (hover: hover) {
    a:hover {
      color: var(--accent);
      transform: translateY(-2px);
    }
  }
</style>
