---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';

interface Props {
  /** The next older post. */
  previous?: CollectionEntry<'blog'>;
  /** The next newer post. */
  next?: CollectionEntry<'blog'>;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav aria-label="More posts">
      {previous && <a href={withBase(`/blog/${previous.id}/`)}>← Previous post</a>}
      {next && <a class="next" href={withBase(`/blog/${next.id}/`)}>Next post →</a>}
    </nav>
  )
}

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  a {
    padding: 0.75rem 1.25rem;
    color: inherit;
    text-decoration: none;
    border: 2px solid CanvasText;
    transition: background-color 150ms;
  }

  .next {
    margin-left: auto;
  }

  @media (hover: hover) {
    a:hover {
      background: var(--hover);
    }
  }
</style>
