<!-- Covers the page until everything on it, including all post pictures, has loaded. -->
<div id="preloader" role="status" aria-label="Loading posts">
  <span data-tag="Develop"></span>
  <span data-tag="Research"></span>
  <span data-tag="Design"></span>
</div>

<!-- Without JS nothing could remove the preloader, so don't show it at all. -->
<noscript><style>#preloader { display: none; }</style></noscript>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: Canvas;
    transition:
      opacity 300ms,
      visibility 300ms;
  }

  #preloader.done {
    opacity: 0;
    visibility: hidden;
  }

  span {
    width: 1rem;
    height: 1rem;
    background: var(--tag-color);
    /* The delay keeps the squares from flashing when the page loads almost instantly. */
    opacity: 0;
    animation: pulse 900ms ease-in-out 200ms infinite;
  }

  span:nth-child(2) {
    animation-delay: 350ms;
  }

  span:nth-child(3) {
    animation-delay: 500ms;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.8);
    }

    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    span {
      opacity: 1;
      animation: none;
    }
  }
</style>

<script>
  const preloader = document.querySelector<HTMLElement>('#preloader')!;
  const finish = () => preloader.classList.add('done');

  if (document.readyState === 'complete') {
    finish();
  } else {
    window.addEventListener('load', finish, { once: true });
    // A picture that never finishes loading shouldn't keep the page covered forever.
    setTimeout(finish, 8000);
  }
</script>
