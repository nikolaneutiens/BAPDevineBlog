---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <div class="gallery">
      {images.map((image) => (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[400, 800]}
          sizes="(max-width: 30rem) 100vw, 21rem"
        />
      ))}
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  @media (max-width: 30rem) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
