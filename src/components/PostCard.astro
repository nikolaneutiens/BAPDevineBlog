---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';
import PostCover from './PostCover.astro';
import PostDate from './PostDate.astro';
import TagList from './TagList.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, cover, coverAlt, tags } = post.data;
---

<li class="post" data-post data-tags={JSON.stringify(tags)}>
  <PostCover src={cover} alt={coverAlt} sizes="(max-width: 30rem) 100vw, 11rem" />
  <div class="body">
    <div class="header">
      <h2>
        <a href={withBase(`/blog/${post.id}/`)}>{title}</a>
      </h2>
      <div class="tags">
        <TagList tags={tags} align="end" />
      </div>
    </div>
    <PostDate date={date} />
    <p class="description">{description}</p>
  </div>
</li>

<style>
  .post {
    position: relative;
    display: grid;
    grid-template-columns: 11rem 1fr;
    overflow: hidden;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition:
      transform var(--post-hover-speed) ease,
      box-shadow var(--post-hover-speed) ease;
  }

  .post:hover,
  .post:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }

  @media (prefers-reduced-motion: reduce) {
    .post:hover,
    .post:focus-within {
      transform: none;
    }
  }

  .body {
    min-width: 0;
    padding: 1.25rem;
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  /* On narrow screens the pills wrap in the corner rather than squeezing the title. */
  .tags {
    flex: none;
    max-width: 50%;
  }

  h2 {
    margin: 0;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .post:hover h2 a {
    color: var(--accent);
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  /* Makes the whole box clickable. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .description {
    margin: 0.5rem 0 0;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 30rem) {
    .post {
      grid-template-columns: 1fr;
    }
  }
</style>
