---
import { Image } from 'astro:assets';
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import WeekSwitcher from '../../components/WeekSwitcher.astro';
import LoggedSessions from '../../components/LoggedSessions.astro';
import WorkTimer from '../../components/WorkTimer.astro';
import { dayLabel, fmtHours, getHours, memberSummary, weekdayLabel } from '../../lib/hours';
import { withBase } from '../../lib/paths';
import { photoOf } from '../../lib/photos';
import { getPosts } from '../../lib/posts';
import { initials, TEAM } from '../../lib/team';

export function getStaticPaths() {
  return TEAM.map((m) => ({ params: { id: m.id }, props: { m } }));
}

const { m } = Astro.props;
const photo = photoOf(m.id);
const posts = (await getPosts()).filter((p) => p.data.author === m.id);
const HOURS = await getHours();
// The same summary is recalculated in the browser for live updates (see the script below).
const { stats, weeks, maxDay } = memberSummary(HOURS, m.id);
---

<Base title={m.name} description={`${m.name}, ${m.role} in our bachelor's project.`}>
  <p class="back"><a href={withBase('/team/')}>← Team</a></p>

  <section class="hero" style={`--c: ${m.color}`}>
    <div class="intro">
      <h1>{m.name}</h1>
      <p class="role">{m.role}</p>
      <dl class="stats">
        <div>
          <dt>Worked in total</dt>
          <dd data-total>{fmtHours(stats.total)}</dd>
        </div>
        <div>
          <dt>Days worked</dt>
          <dd data-days>{stats.days.length}</dd>
        </div>
        <div>
          <dt>Per day on average</dt>
          <dd data-average>{fmtHours(stats.average)}</dd>
        </div>
        <div>
          <dt>Blog posts</dt>
          <dd>{posts.length}</dd>
        </div>
      </dl>
    </div>
    <div class="photo">
      {
        photo ? (
          <Image src={photo} alt={`Photo of ${m.name}`} widths={[320, 640]} sizes="(max-width: 40rem) 60vw, 16rem" />
        ) : (
          <span class="initials" aria-hidden="true">
            {initials(m.name)}
          </span>
        )
      }
    </div>
  </section>

  <WorkTimer person={m.id} />
  <LoggedSessions person={m.id} />

  <section aria-labelledby="hours-title" data-live-hours={m.id}>
    <h2 id="hours-title">Hours worked</h2>
    {
      stats.entries.length === 0 ? (
        <p class="empty">No hours logged yet.</p>
      ) : (
        <WeekSwitcher titles={weeks.map((w) => w.title)}>
          {weeks.map((w, i) => (
            <div
              class="chart"
              role="img"
              aria-label={`Hours per day worked by ${m.name} in week ${w.number}`}
              data-week
              data-title={w.title}
              hidden={i !== weeks.length - 1}
            >
              {w.days.map((d) => (
                <div
                  class:list={['day', { off: d.hours === 0 }]}
                  data-date={d.date}
                  title={`${dayLabel(d.date)}: ${fmtHours(d.hours)}${d.tasks.length ? ' — ' + d.tasks.join(', ') : ''}`}
                >
                  <span class="day-total">{d.hours ? fmtHours(d.hours) : ''}</span>
                  <span class="bar" style={`--c: ${m.color}; height: ${(d.hours / maxDay) * 100}%`} />
                  <span class="day-label">
                    <b>{weekdayLabel(d.date)}</b>
                    {dayLabel(d.date)}
                  </span>
                </div>
              ))}
            </div>
          ))}
        </WeekSwitcher>
      )
    }
  </section>

  <section aria-labelledby="posts-title">
    <h2 id="posts-title">Blog posts</h2>
    {
      posts.length === 0 ? (
        <p class="empty">No blog posts yet.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      )
    }
  </section>
</Base>

<script>
  // Live update: recalculate this person's hours (including what was just timed or added) and redraw the chart.
  import { dayLabel, fmtHours, getHours, memberSummary } from '../../lib/hours';
  import type { MemberId } from '../../lib/team';
  import { db } from '../../lib/teamAuth';

  const section = document.querySelector<HTMLElement>('[data-live-hours]');
  if (section) {
    const person = section.dataset.liveHours as MemberId;

    async function refresh() {
      const { stats, weeks, maxDay } = memberSummary(await getHours(), person);
      const set = (sel: string, text: string) => document.querySelectorAll(sel).forEach((n) => (n.textContent = text));
      set('[data-total]', fmtHours(stats.total));
      set('[data-days]', String(stats.days.length));
      set('[data-average]', fmtHours(stats.average));
      for (const w of weeks) {
        for (const d of w.days) {
          const day = section!.querySelector<HTMLElement>(`.day[data-date="${d.date}"]`);
          if (!day) continue;
          day.closest<HTMLElement>('[data-week]')!.dataset.title = w.title;
          day.classList.toggle('off', d.hours === 0);
          day.title = `${dayLabel(d.date)}: ${fmtHours(d.hours)}${d.tasks.length ? ' — ' + d.tasks.join(', ') : ''}`;
          day.querySelector('.day-total')!.textContent = d.hours ? fmtHours(d.hours) : '';
          day.querySelector<HTMLElement>('.bar')!.style.height = `${(d.hours / maxDay) * 100}%`;
        }
      }
      const visible = section!.querySelector<HTMLElement>('[data-week]:not([hidden])');
      const title = section!.querySelector('[data-title]:not([data-week])');
      if (visible && title) title.textContent = visible.dataset.title ?? '';
    }

    let timer: ReturnType<typeof setTimeout> | undefined;
    db.channel(`hours-${person}`)
      .on('postgres_changes', { event: '*', schema: 'public', table: 'time_entries' }, () => {
        clearTimeout(timer);
        timer = setTimeout(refresh, 400);
      })
      .subscribe();
    refresh();
  }
</script>

<style>
  .back {
    margin: 0 0 1.5rem;
  }

  .back a {
    font-weight: 700;
    text-decoration: none;
  }

  .hero {
    display: grid;
    grid-template-columns: 1fr 15rem;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  h1 {
    margin: 0;
  }

  .role {
    margin: 0.35rem 0 1.5rem;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  dt {
    font-size: 0.85rem;
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c);
    border-radius: calc(var(--radius) * 1.4);
    box-shadow: var(--shadow-lift);
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 4.5rem;
    font-weight: 800;
    color: var(--tag-text);
    box-shadow: inset 0 -1rem 0 rgb(0 0 0 / 0.1);
  }

  section h2 {
    margin: 0 0 1rem;
    font-size: 1.5rem;
  }

  section + section {
    margin-top: 2.75rem;
  }

  .empty {
    padding: 1.25rem;
    color: var(--muted);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .chart {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    height: 13rem;
    padding: 1rem 0.75rem 0;
    overflow-x: auto;
    background: var(--surface);
    border-radius: var(--radius);
  }

  .day {
    display: flex;
    flex: 1 0 2.4rem;
    flex-direction: column;
    align-items: center;
    height: 100%;
  }

  .day-total {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Hours and minutes are wider than plain hours, so make them smaller on phones. */
  @media (max-width: 30rem) {
    .day-total {
      font-size: 0.6rem;
    }
  }

  .bar {
    width: 70%;
    min-height: 2px;
    margin-top: auto;
    background: var(--c);
    border-radius: 5px 5px 0 0;
  }

  .day-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.35rem 0 0.5rem;
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .day-label b {
    color: var(--text, inherit);
  }

  .off .day-label {
    opacity: 0.55;
  }

  .chart[hidden] {
    display: none;
  }

  .posts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 40rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .photo {
      order: -1;
      width: 60%;
      max-width: 15rem;
    }
  }
</style>
