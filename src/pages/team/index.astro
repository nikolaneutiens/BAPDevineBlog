---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import WeekSwitcher from '../../components/WeekSwitcher.astro';
import { dayLabel, fmtHours as fmt, getHours, teamSummary, weekdayLabel } from '../../lib/hours';
import { withBase } from '../../lib/paths';
import { photoOf } from '../../lib/photos';
import { getPosts } from '../../lib/posts';
import { initials, TEAM } from '../../lib/team';

const posts = await getPosts();
const HOURS = await getHours();

// ---- hours statistics (the same summary is recalculated in the browser, see the script below)
const { total, perPerson, maxPerson, days, average, maxDay, weeks } = teamSummary(HOURS);

// The member cards lean a little, like cards spread out on a table.
const TILTS = [-4, 2.5, -2];
---

<Base wide title="Team" description="Who we are, who does what, and how many hours we spend on our bachelor's project.">
  <h1>Team</h1>
  <p class="intro">We are three students working on our bachelor's project at Devine. This is who does what.</p>

  <ul class="people" aria-label="Team members">
    {
      TEAM.map((m, i) => {
        const own = posts.filter((p) => p.data.author === m.id);
        const hours = HOURS.filter((h) => h.person === m.id).reduce((s, h) => s + h.hours, 0);
        const photo = photoOf(m.id);
        return (
          <li class="person" data-reveal id={m.id} style={`--c: ${m.color}; --tilt: ${TILTS[i % TILTS.length]}deg`}>
            <span class="number" aria-hidden="true">
              0{i + 1}
            </span>
            <span class="face" aria-hidden="true">
              {photo ? <Image src={photo} alt="" widths={[240, 480]} sizes="9rem" /> : initials(m.name)}
            </span>
            <h2>
              <a href={withBase(`/team/${m.id}/`)}>{m.name}</a>
            </h2>
            <p class="card-role">{m.role}</p>
            <p class="facts">
              <span data-member-hours={m.id}>{fmt(hours)}</span> worked · {own.length} {own.length === 1 ? 'post' : 'posts'}
            </p>
            <span class="go" aria-hidden="true">
              View profile →
            </span>
          </li>
        );
      })
    }
  </ul>

  <section class="hours" aria-labelledby="hours-title" data-live-hours data-reveal>
    <h2 id="hours-title">Hours</h2>
    <p class="intro">How many hours each of us spends on the bachelor's project, per day.</p>

    {
      HOURS.length === 0 ? (
        <p class="empty">No hours logged yet.</p>
      ) : (
        <>
          <div class="tiles">
            <div class="tile">
              <span class="value" data-total>{fmt(total)}</span>
              <span class="label">worked in total</span>
            </div>
            <div class="tile">
              <span class="value" data-days>{days.length}</span>
              <span class="label">days worked</span>
            </div>
            <div class="tile">
              <span class="value" data-average>{fmt(average)}</span>
              <span class="label">per day on average</span>
            </div>
          </div>

          <h3>Per person</h3>
          <ul class="bars">
            {perPerson.map((p) => (
              <li data-person={p.id}>
                <span class="bar-name">{p.name}</span>
                <span class="bar-track">
                  <span class="bar" style={`--c: ${p.color}; width: ${(p.hours / maxPerson) * 100}%`} />
                </span>
                <span class="bar-value">{fmt(p.hours)}</span>
              </li>
            ))}
          </ul>

          <h3>Per day</h3>
          <WeekSwitcher titles={weeks.map((w) => w.title)}>
            {weeks.map((w, i) => (
              <div
                class="chart"
                role="img"
                aria-label={`Hours per day in week ${w.number}, stacked per team member`}
                data-week
                data-title={w.title}
                hidden={i !== weeks.length - 1}
              >
                {w.days.map((d) => (
                  <div class:list={['day', { off: d.sum === 0 }]} data-date={d.date} title={`${dayLabel(d.date)}: ${fmt(d.sum)}`}>
                    <span class="day-total">{d.sum ? fmt(d.sum) : ''}</span>
                    <div class="stack" style={`height: ${(d.sum / maxDay) * 100}%`}>
                      {d.parts
                        .filter((p) => p.hours > 0)
                        .map((p) => (
                          <span style={`--c: ${p.color}; flex: ${p.hours}`} title={`${p.name}: ${fmt(p.hours)}`} />
                        ))}
                    </div>
                    <span class="day-label">
                      <b>{weekdayLabel(d.date)}</b>
                      {dayLabel(d.date)}
                    </span>
                  </div>
                ))}
              </div>
            ))}
          </WeekSwitcher>
          <ul class="legend">
            {TEAM.map((m) => (
              <li>
                <span style={`--c: ${m.color}`} />
                {m.name}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>

<script>
  // Live update: recalculate the hours (including what was just timed or added) and redraw the numbers and bars.
  import { fmtHours as fmt, getHours, teamSummary } from '../../lib/hours';
  import { db } from '../../lib/teamAuth';

  const section = document.querySelector<HTMLElement>('[data-live-hours]');
  if (section) {
    // Elements made here need the page's style-scope attribute to pick up the page's CSS.
    const scope = [...section.attributes].find((a) => a.name.startsWith('data-astro-cid-'))?.name;

    async function refresh() {
      const s = teamSummary(await getHours());
      const set = (sel: string, text: string) => document.querySelectorAll(sel).forEach((n) => (n.textContent = text));
      set('[data-total]', fmt(s.total));
      set('[data-days]', String(s.days.length));
      set('[data-average]', fmt(s.average));
      for (const p of s.perPerson) {
        set(`[data-member-hours="${p.id}"]`, fmt(p.hours));
        const row = section!.querySelector(`[data-person="${p.id}"]`);
        if (!row) continue;
        row.querySelector<HTMLElement>('.bar')!.style.width = `${(p.hours / s.maxPerson) * 100}%`;
        row.querySelector('.bar-value')!.textContent = fmt(p.hours);
      }
      for (const w of s.weeks) {
        for (const d of w.days) {
          const day = section!.querySelector<HTMLElement>(`.day[data-date="${d.date}"]`);
          if (!day) continue;
          day.closest<HTMLElement>('[data-week]')!.dataset.title = w.title;
          day.classList.toggle('off', d.sum === 0);
          day.title = `${day.title.split(':')[0]}: ${fmt(d.sum)}`;
          day.querySelector('.day-total')!.textContent = d.sum ? fmt(d.sum) : '';
          const stack = day.querySelector<HTMLElement>('.stack')!;
          stack.style.height = `${(d.sum / s.maxDay) * 100}%`;
          stack.replaceChildren(
            ...d.parts
              .filter((p) => p.hours > 0)
              .map((p) => {
                const part = document.createElement('span');
                if (scope) part.setAttribute(scope, '');
                part.style.setProperty('--c', p.color);
                part.style.flex = String(p.hours);
                part.title = `${p.name}: ${fmt(p.hours)}`;
                return part;
              }),
          );
        }
      }
      // The week title above the chart.
      const visible = section!.querySelector<HTMLElement>('[data-week]:not([hidden])');
      const title = section!.querySelector('[data-title]:not([data-week])');
      if (visible && title) title.textContent = visible.dataset.title ?? '';
    }

    let timer: ReturnType<typeof setTimeout> | undefined;
    db.channel('team-hours')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'time_entries' }, () => {
        clearTimeout(timer);
        timer = setTimeout(refresh, 400);
      })
      .subscribe();
    refresh();
  }
</script>

<style>
  h1 {
    margin: 0 0 0.5rem;
  }

  .intro {
    margin: 0 0 1.75rem;
    color: var(--muted);
  }

  /* ---------- the team: three big cards, spread out a little like on a table */
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin: 0 0 4rem;
    padding: 1rem 0.5rem 0;
    list-style: none;
  }

  .person {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    min-height: 26rem;
    padding: 1.5rem;
    color: var(--tag-text);
    background: var(--c);
    border-radius: 20px;
    box-shadow: var(--shadow), inset 0 -0.6rem 0 rgb(0 0 0 / 0.1);
    rotate: var(--tilt);
    transition:
      rotate 350ms ease,
      translate 350ms ease,
      scale 350ms ease,
      box-shadow 350ms ease,
      opacity 600ms ease;
  }

  .person:hover,
  .person:focus-within {
    rotate: 0deg;
    translate: 0 -6px;
    scale: 1.02;
    box-shadow: var(--shadow-lift), inset 0 -0.6rem 0 rgb(0 0 0 / 0.1);
  }

  .person:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  .person a:focus-visible {
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .person {
      transition: none;
    }

    .person:hover,
    .person:focus-within {
      translate: none;
      scale: none;
    }
  }

  .number {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    opacity: 0.65;
  }

  .face {
    display: grid;
    place-items: center;
    width: 9rem;
    height: 9rem;
    margin: auto 0 1.25rem;
    overflow: hidden;
    font-size: 3rem;
    font-weight: 800;
    background: rgb(255 255 255 / 0.5);
    border-radius: 22px;
    rotate: -6deg;
    transition: rotate 350ms ease;
  }

  .person:hover .face {
    rotate: 0deg;
  }

  .face img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person h2 {
    margin: 0;
    font-size: 1.9rem;
    line-height: 1.05;
  }

  .person h2 a {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is clickable. */
  .person h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-role {
    margin: 0.4rem 0 0;
    font-weight: 700;
    line-height: 1.3;
    opacity: 0.85;
  }

  .facts {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .go {
    margin-top: 1.1rem;
    padding: 0.35rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 800;
    background: rgb(255 255 255 / 0.45);
    border-radius: 999px;
    transition: background-color 250ms ease;
  }

  .person:hover .go {
    background: rgb(255 255 255 / 0.75);
  }

  @media (max-width: 52rem) {
    .people {
      gap: 1.1rem;
    }

    .person {
      min-height: 22rem;
      padding: 1.2rem;
    }

    .face {
      width: 6.5rem;
      height: 6.5rem;
      font-size: 2.2rem;
    }

    .person h2 {
      font-size: 1.5rem;
    }
  }

  /* On phones the cards stack, still big, still leaning a little. */
  @media (max-width: 36rem) {
    .people {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-inline: 0.75rem;
    }

    .person {
      min-height: 0;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1.1rem;
      align-items: center;
    }

    .number {
      grid-column: 1 / -1;
    }

    .face {
      grid-row: span 4;
      width: 6rem;
      height: 6rem;
      margin: 0.5rem 0;
    }

    .go {
      justify-self: start;
      margin-top: 0.75rem;
    }
  }

  .hours h2 {
    margin: 0 0 0.5rem;
  }

  .hours h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.1rem;
  }

  .empty {
    padding: 1.25rem;
    color: var(--muted);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
  }

  .tile {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .value {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .label {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .bars {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bars li {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .bar-name {
    font-weight: 600;
  }

  .bar-track {
    height: 0.9rem;
    background: var(--hover);
    border-radius: 999px;
    overflow: hidden;
  }

  .bar {
    display: block;
    height: 100%;
    background: var(--c);
    border-radius: 999px;
  }

  .bar-value {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    text-align: right;
  }

  .chart {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    height: 13rem;
    padding: 1rem 0.75rem 0;
    overflow-x: auto;
    background: var(--surface);
    border-radius: var(--radius);
  }

  /* The bar sits in its own row, so its height is a share of that row and not squeezed by the labels. */
  .day {
    display: grid;
    flex: 1 0 2.4rem;
    grid-template-rows: auto minmax(0, 1fr) auto;
    justify-items: center;
    height: 100%;
  }

  .day-total {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Hours and minutes are wider than plain hours, so make them smaller on phones. */
  @media (max-width: 30rem) {
    .day-total {
      font-size: 0.6rem;
    }
  }

  .stack {
    display: flex;
    flex-direction: column-reverse;
    width: 70%;
    min-height: 2px;
    align-self: end;
    overflow: hidden;
    border-radius: 5px 5px 0 0;
  }

  .stack span {
    background: var(--c);
  }

  .day-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.35rem 0 0.5rem;
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .day-label b {
    color: var(--text, inherit);
  }

  .off .day-label {
    opacity: 0.55;
  }

  .chart[hidden] {
    display: none;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0.75rem 0 0;
    padding: 0;
    font-size: 0.85rem;
    list-style: none;
  }

  .legend span {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.35rem;
    background: var(--c);
    border-radius: 3px;
  }

  @media (max-width: 30rem) {
    .bars li {
      grid-template-columns: 1fr auto;
    }

    .bar-name {
      grid-column: 1 / -1;
    }
  }
</style>
