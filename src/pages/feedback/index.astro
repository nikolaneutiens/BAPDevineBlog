---
import { getCollection } from 'astro:content';
import Author from '../../components/Author.astro';
import PostDate from '../../components/PostDate.astro';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';

const reports = (await getCollection('feedback')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Feedback" description="Reports of our feedback sessions with the customer, experts and teachers.">
  <h1>Feedback</h1>
  <p class="intro">
    Reports of our talks with the customer, experts and teachers: what we showed, what feedback we got and what we
    did with it.
  </p>

  {
    reports.length === 0 ? (
      <p class="empty">No feedback reports yet.</p>
    ) : (
      <ul class="reports">
        {reports.map((r) => (
          <li class="report">
            <div class="top">
              <span class="type">{r.data.type}</span>
              <PostDate date={r.data.date} />
            </div>
            <h2>
              <a href={withBase(`/feedback/${r.id}/`)}>{r.data.title}</a>
            </h2>
            <p class="with">With {r.data.with}</p>
            <p class="summary">{r.data.summary}</p>
            <Author id={r.data.author} />
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  h1 {
    margin: 0 0 0.5rem;
  }

  .intro {
    margin: 0 0 1.75rem;
    color: var(--muted);
  }

  .empty {
    padding: 1.25rem;
    color: var(--muted);
    background: var(--surface);
    border-radius: var(--radius);
  }

  .reports {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .report {
    position: relative;
    padding: 1.25rem;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform var(--post-hover-speed) ease, box-shadow var(--post-hover-speed) ease;
  }

  .report:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .type {
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
  }

  h2 {
    margin: 0.6rem 0 0.2rem;
    font-size: 1.35rem;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .report:hover h2 a {
    color: var(--accent);
  }

  .with {
    margin: 0;
    font-weight: 600;
  }

  .summary {
    margin: 0.4rem 0 0.75rem;
    color: var(--muted);
  }
</style>
