---
import { getCollection, render } from 'astro:content';
import Author from '../../components/Author.astro';
import Base from '../../layouts/Base.astro';
import { categoryLabel, feedbackDate } from '../../lib/feedback';
import { withBase } from '../../lib/paths';
import { member } from '../../lib/team';

export async function getStaticPaths() {
  const reports = await getCollection('feedback');
  return reports.map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const { title, date, monthOnly, category, description, intro, takeaways, sections, author, attendees } =
  report.data;
const hasBody = Boolean(report.body?.trim());
---

<Base title={title} description={description}>
  <p class="back"><a href={withBase('/feedback/')}>← Back to Feedback</a></p>

  <article>
    <header>
      <div class="top">
        <span class="category">{categoryLabel(category)}</span>
        <time datetime={date.toISOString()}>{feedbackDate(date, monthOnly)}</time>
      </div>
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
      {
        (author || attendees.length > 0) && (
          <div class="people">
            {author && <Author id={author} linked />}
            {attendees.length > 0 && <span>Present: {attendees.map((a) => member(a).name).join(', ')}</span>}
          </div>
        )
      }
    </header>

    {
      takeaways.length > 0 && (
        <section class="takeaways" aria-labelledby="takeaways-title">
          <h2 id="takeaways-title">Key Takeaways</h2>
          <ul>
            {takeaways.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      sections.length > 0 && (
        <section class="report" aria-labelledby="report-title">
          <h2 id="report-title">Full Feedback Report</h2>
          {sections.map((s) => (
            <section class="topic">
              <h3>{s.topic}</h3>
              <dl>
                {(s.feedback || s.details.length > 0) && (
                  <div class="row">
                    <dt>Feedback received</dt>
                    <dd>
                      {s.feedback && <p>{s.feedback}</p>}
                      {s.details.length > 0 && (
                        <ul>
                          {s.details.map((d) => (
                            <li>{d}</li>
                          ))}
                        </ul>
                      )}
                    </dd>
                  </div>
                )}
                {(s.response || s.responseSteps.length > 0) && (
                  <div class="row">
                    <dt>Our response</dt>
                    <dd>
                      {s.response && <p>{s.response}</p>}
                      {s.responseSteps.length > 0 && (
                        <ol>
                          {s.responseSteps.map((step) => (
                            <li>{step}</li>
                          ))}
                        </ol>
                      )}
                    </dd>
                  </div>
                )}
                {s.decision && (
                  <div class="row decision">
                    <dt>Decision</dt>
                    <dd>
                      <p>{s.decision}</p>
                    </dd>
                  </div>
                )}
                {s.next && (
                  <div class="row next">
                    <dt>Next step</dt>
                    <dd>
                      <p>{s.next}</p>
                    </dd>
                  </div>
                )}
              </dl>
            </section>
          ))}
        </section>
      )
    }

    {hasBody && <div class="body"><Content /></div>}

  </article>

  <p class="back bottom"><a href={withBase('/feedback/')}>← Back to Feedback</a></p>
</Base>

<style>
  .back {
    margin: 0 0 1.5rem;
  }

  .back a {
    font-weight: 700;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
  }

  .back.bottom {
    margin: 2.5rem 0 0;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .category {
    padding: 0.1rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
  }

  h1 {
    margin: 0.6rem 0 0.6rem;
  }

  .intro {
    margin: 0;
    font-size: 1.15rem;
  }

  .people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.4rem;
  }

  article > section {
    margin-top: 2.25rem;
  }

  /* Key takeaways: a compact card before the full report. */
  .takeaways {
    padding: 1.25rem 1.4rem;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .takeaways ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .takeaways li {
    position: relative;
    padding-left: 1.4rem;
  }

  .takeaways li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0.2rem;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    border-radius: 2px;
  }

  /* Full report: one block per topic. */
  .topic {
    padding: 1.15rem 1.35rem;
    background: var(--surface);
    border-radius: var(--radius);
  }

  .topic + .topic {
    margin-top: 0.85rem;
  }

  h3 {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
  }

  dl {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 0.2rem 1rem;
  }

  dt {
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.9;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .decision dt,
  .next dt {
    color: var(--accent);
  }

  dd {
    margin: 0;
  }

  dd p {
    margin: 0;
  }

  dd ul,
  dd ol {
    margin: 0.35rem 0 0;
    padding-left: 1.3rem;
  }

  dd li + li {
    margin-top: 0.15rem;
  }

  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
    }

    dt {
      line-height: 1.4;
    }
  }

  @view-transition {
    navigation: auto;
  }
</style>
