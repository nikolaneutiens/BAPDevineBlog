---
import { render } from 'astro:content';
import AiNote from '../../components/AiNote.astro';
import Author from '../../components/Author.astro';
import PostDate from '../../components/PostDate.astro';
import PostGallery from '../../components/PostGallery.astro';
import PostNav from '../../components/PostNav.astro';
import TagList from '../../components/TagList.astro';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/paths';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Posts are sorted newest first, so the older post comes after this one.
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, previous: posts[index + 1], next: posts[index - 1] },
  }));
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const { title, description, date, gallery, tags, author, ai } = post.data;
---

<Base title={title} description={description}>
  <p class="back"><a href={withBase('/')}>← All posts</a></p>
  <article>
    <div class="header">
      <h1>{title}</h1>
      <div class="tags">
        <TagList tags={tags} linked align="end" />
      </div>
    </div>
    <div class="meta">
      {author && <Author id={author} linked />}
      <PostDate date={date} />
    </div>
    <Content />
    <PostGallery images={gallery} />
    {ai && <AiNote text={ai} />}
    <PostNav previous={previous} next={next} />
  </article>
</Base>

<style>
  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  h1 {
    margin: 0;
  }

  .back {
    margin: 0 0 1.5rem;
  }

  .back a {
    font-weight: 700;
    text-decoration: none;
  }

  .back a:hover {
    text-decoration: underline;
  }

  /* The intro paragraph right under the date reads a bit larger. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
  }

  article :global(.meta + p) {
    margin-top: 1.5rem;
    font-size: 1.2rem;
    line-height: 1.55;
  }

  /* On narrow screens the pills wrap in the corner rather than squeezing the title. */
  .tags {
    flex: none;
    max-width: 50%;
    margin-top: 0.5rem;
  }
</style>
