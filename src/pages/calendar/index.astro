---
import Base from '../../layouts/Base.astro';
import { EVENTS, TRACKS } from '../../lib/calendar';
import { TEAM } from '../../lib/team';

const team = TEAM.map(({ id, name, color }) => ({ id, name, color }));
---

<Base title="Calendar" description="Our planning for the BAP project: what we work on each day, per track.">
  <h1>Calendar</h1>
  <p class="intro">
    Our planning: what we work on each day, split into design, UX and development. Tasks update live for everyone.
  </p>

  <div class="toolbar">
    <ul class="legend" aria-label="Tracks">
      {
        TRACKS.map((t) => (
          <li data-tag={t.tag}>
            <span class="dot" aria-hidden="true" />
            {t.label}
          </li>
        ))
      }
    </ul>

  </div>

  <form class="add-form" data-add-global hidden>
    <p class="add-title">New task</p>
    <div class="row">
      <input name="title" type="text" placeholder="What needs to happen?" maxlength="200" required />
    </div>
    <div class="row">
      <input name="date" type="date" required aria-label="Day" />
      <select name="track" aria-label="Track">
        {TRACKS.map((t) => <option value={t.id}>{t.label}</option>)}
      </select>
      <button type="submit" class="pill">Add</button>
    </div>
    <div class="row people-pick" role="group" aria-label="Who does it">
      {
        team.map((m) => (
          <label class="person-toggle" style={`--c: ${m.color}`}>
            <input type="checkbox" name="assignees" value={m.id} />
            {m.name.split(' ')[0]}
          </label>
        ))
      }
    </div>
  </form>

  <p class="message" data-message hidden></p>
  <div data-calendar aria-busy="true">
    <p class="loading">Loading the planning…</p>
  </div>

  <script is:inline type="application/json" id="calendar-data" set:html={JSON.stringify({ events: EVENTS, tracks: TRACKS, team })}
  ></script>
</Base>

<script>
  import type { Task } from '../../lib/supabase';
  import { canEdit, db, onAuthChange, teamCall } from '../../lib/teamAuth';

  type Track = { id: Task['track']; label: string; tag: string };
  type Member = { id: Task['assignees'][number]; name: string; color: string };
  type Event = { date: string; time?: string; title: string };

  const { events, tracks, team } = JSON.parse(document.getElementById('calendar-data')!.textContent!) as {
    events: Event[];
    tracks: Track[];
    team: Member[];
  };

  const root = document.querySelector<HTMLElement>('[data-calendar]')!;
  const messageEl = document.querySelector<HTMLElement>('[data-message]')!;
  const globalAdd = document.querySelector<HTMLFormElement>('[data-add-global]')!;

  let tasks: Task[] = [];
  let loaded = false;
  const openForms = new Set<string>(); // days with an open "add task" form

  // ---------- talking to the database
  function showMessage(text: string) {
    messageEl.textContent = text;
    messageEl.hidden = false;
    clearTimeout((showMessage as any).t);
    (showMessage as any).t = setTimeout(() => (messageEl.hidden = true), 6000);
  }

  async function call(fn: string, args: Record<string, unknown>) {
    const problem = await teamCall(fn, args);
    if (problem) {
      showMessage(problem);
      return false;
    }
    await load();
    return true;
  }

  async function load() {
    const t = await db.from('tasks').select('*').order('created_at');
    if (t.error) {
      root.setAttribute('aria-busy', 'false');
      root.replaceChildren(el('p', { class: 'message' }, 'Could not load the planning. Try again later.'));
      return;
    }
    tasks = t.data as Task[];
    loaded = true;
    render();
  }

  let reloadTimer: ReturnType<typeof setTimeout> | undefined;
  db.channel('calendar')
    .on('postgres_changes', { event: '*', schema: 'public', table: 'tasks' }, () => scheduleReload())
    .subscribe();
  function scheduleReload() {
    clearTimeout(reloadTimer);
    reloadTimer = setTimeout(load, 250);
  }

  // ---------- dates
  const DAY = 86_400_000;
  const iso = (t: number) => new Date(t).toISOString().slice(0, 10);
  const utc = (d: string) => Date.parse(d + 'T00:00:00Z');
  const mondayOf = (d: string) => utc(d) - ((new Date(utc(d)).getUTCDay() + 6) % 7) * DAY;
  const fmt = (d: string, o: Intl.DateTimeFormatOptions) =>
    new Date(utc(d)).toLocaleDateString('en-GB', { timeZone: 'UTC', ...o });
  const todayIso = () => {
    const n = new Date();
    return `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, '0')}-${String(n.getDate()).padStart(2, '0')}`;
  };

  // ---------- small DOM helper (text always goes in as text, never as HTML)
  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    attrs: Record<string, string | boolean | undefined> = {},
    ...children: (Node | string | null | false | undefined)[]
  ) {
    const node = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (v === undefined || v === false) continue;
      node.setAttribute(k, v === true ? '' : v);
    }
    for (const c of children) if (c) node.append(c);
    return node;
  }

  // ---------- rendering
  const firstName = (m: Member) => m.name.split(' ')[0];

  function personChip(m: Member) {
    const chip = el('span', { class: 'chip', title: m.name }, firstName(m));
    chip.style.setProperty('--c', m.color);
    return chip;
  }

  /** Checkboxes to pick people in an "add task" form (sent as "assignees"). */
  function peoplePicker() {
    return el(
      'div',
      { class: 'row people-pick', role: 'group', 'aria-label': 'Who does it' },
      ...team.map((m) => {
        const label = el('label', { class: 'person-toggle' }, el('input', { type: 'checkbox', name: 'assignees', value: m.id }), firstName(m));
        label.style.setProperty('--c', m.color);
        return label;
      }),
    );
  }

  function taskItem(task: Task) {
    const item = el('li', { class: `task${task.done ? ' done' : ''}` });
    item.dataset.id = task.id;

    const check = el('input', {
      type: 'checkbox',
      'aria-label': `Done: ${task.title}`,
      disabled: !canEdit(),
    }) as HTMLInputElement;
    check.checked = task.done;
    check.addEventListener('change', () => call('update_task', { task_id: task.id, task_done: check.checked }));

    const head = el('div', { class: 'task-head' }, check, el('span', { class: 'task-title' }, task.title));

    const meta = el('div', { class: 'task-meta' });
    if (canEdit()) {
      // One toggle per person: click to add or remove them from this task.
      for (const m of team) {
        const on = task.assignees.includes(m.id);
        const toggle = el(
          'button',
          { type: 'button', class: 'person-toggle', 'aria-pressed': on ? 'true' : 'false', title: `${on ? 'Remove' : 'Add'} ${m.name}` },
          firstName(m),
        );
        toggle.style.setProperty('--c', m.color);
        toggle.addEventListener('click', () => {
          const next = on ? task.assignees.filter((id) => id !== m.id) : team.map((p) => p.id).filter((id) => id === m.id || task.assignees.includes(id));
          call('set_task_assignees', { task_id: task.id, task_assignees: next });
        });
        meta.append(toggle);
      }
    } else {
      for (const m of team) if (task.assignees.includes(m.id)) meta.append(personChip(m));
    }

    if (canEdit()) {
      const del = el('button', { type: 'button', class: 'icon delete', title: 'Delete', 'aria-label': `Delete: ${task.title}` }, '✕');
      del.addEventListener('click', () => {
        if (confirm(`Delete "${task.title}"?`)) call('delete_task', { task_id: task.id });
      });
      head.append(del);
    }

    item.append(head);
    if (meta.childElementCount) item.append(meta);
    return item;
  }

  function addForm(date: string) {
    const form = el(
      'form',
      { class: 'add-form inline' },
      el('div', { class: 'row' }, el('input', { name: 'title', type: 'text', placeholder: 'What needs to happen?', maxlength: '200', required: true, 'aria-label': 'Task' })),
      el(
        'div',
        { class: 'row' },
        el('select', { name: 'track', 'aria-label': 'Track' }, ...tracks.map((t) => el('option', { value: t.id }, t.label))),
        el('button', { type: 'submit', class: 'pill' }, 'Add'),
        el('button', { type: 'button', class: 'pill ghost', 'data-cancel': true }, 'Cancel'),
      ),
      peoplePicker(),
    ) as HTMLFormElement;
    form.querySelector('[data-cancel]')!.addEventListener('click', () => {
      openForms.delete(date);
      render();
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const ok = await call('add_task_for', {
        task_date: date,
        task_track: f.get('track'),
        task_title: String(f.get('title')),
        task_assignees: f.getAll('assignees'),
      });
      if (ok) openForms.delete(date), render();
    });
    return form;
  }

  // ---------- the carousel: one day open at a time, today by default
  let activeDate = todayIso();
  let viewport: HTMLElement | null = null;
  let follow = 0;

  /** Little coloured squares per track, so a closed day still shows what's on it. */
  function peek(dayTasks: Task[], dayEvents: Event[]) {
    const box = el('span', { class: 'peek', 'aria-hidden': 'true' });
    for (const t of tracks) {
      const n = dayTasks.filter((x) => x.track === t.id).length;
      if (n) box.append(el('span', { class: 'peek-dot', 'data-tag': t.tag }, String(n)));
    }
    if (dayEvents.length) box.append(el('span', { class: 'peek-event' }, '★'));
    return box;
  }

  function dayCard(date: string) {
    const dayEvents = events.filter((e) => e.date === date);
    const dayTasks = tasks.filter((t) => t.date === date);
    const isToday = date === todayIso();
    const card = el('li', { class: `day${isToday ? ' is-today' : ''}`, 'aria-current': isToday ? 'date' : undefined });

    const toggle = el(
      'button',
      { type: 'button', class: 'day-toggle', 'aria-label': fmt(date, { weekday: 'long', day: 'numeric', month: 'long' }) },
      el(
        'time',
        { class: 'date', datetime: date },
        el('span', { class: 'weekday' }, fmt(date, { weekday: 'short' })),
        el('span', { class: 'number' }, fmt(date, { day: 'numeric' })),
        el('span', { class: 'month' }, fmt(date, { month: 'short' })),
        isToday ? el('span', { class: 'today-badge' }, 'Today') : null,
      ),
      peek(dayTasks, dayEvents),
    );
    toggle.addEventListener('click', () => setActive(date));
    card.append(toggle);

    const plan = el('div', { class: 'plan' });
    for (const ev of dayEvents) {
      plan.append(el('p', { class: 'event' }, ev.time ? el('span', { class: 'event-time' }, ev.time) : null, ev.title));
    }

    const used = tracks.map((t, i) => ({ t, i, list: dayTasks.filter((x) => x.track === t.id) })).filter((x) => x.list.length);
    if (used.length) {
      const grid = el('div', { class: 'tracks' });
      for (const { t, i, list } of used) {
        const col = el('section', { class: 'track', 'data-tag': t.tag }, el('h3', {}, t.label), el('ul', { class: 'tasks' }, ...list.map(taskItem)));
        col.style.setProperty('--col', String(i + 1));
        grid.append(col);
      }
      plan.append(grid);
    } else if (!dayEvents.length) {
      plan.append(el('p', { class: 'nothing' }, 'Nothing planned.'));
    }

    if (canEdit()) {
      if (openForms.has(date)) plan.append(addForm(date));
      else {
        const add = el('button', { type: 'button', class: 'add-btn' }, '+ Add task');
        add.addEventListener('click', () => {
          openForms.add(date);
          render();
          root.querySelector<HTMLInputElement>(`.day[data-date="${date}"] .add-form input`)?.focus();
        });
        plan.append(add);
      }
    }

    card.append(el('div', { class: 'plan-wrap' }, plan));
    card.dataset.date = date;
    return card;
  }

  /** Keeps the open day in the middle of the strip, also while it is growing. */
  function centre(smooth: boolean) {
    cancelAnimationFrame(follow);
    const card = viewport?.querySelector<HTMLElement>('.day.is-active');
    if (!viewport || !card) return;
    const place = () => (viewport!.scrollTop = card.offsetTop + card.offsetHeight / 2 - viewport!.clientHeight / 2);
    if (!smooth) return place();
    const end = performance.now() + 500;
    const step = () => {
      place();
      if (performance.now() < end) follow = requestAnimationFrame(step);
    };
    step();
  }

  function setActive(date: string, smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    activeDate = date;
    const cards = [...root.querySelectorAll<HTMLElement>('.day')];
    const index = cards.findIndex((c) => c.dataset.date === date);
    for (const card of cards) {
      const on = card.dataset.date === date;
      card.classList.toggle('is-active', on);
      card.querySelector('.day-toggle')!.setAttribute('aria-expanded', String(on));
      card.querySelector<HTMLElement>('.plan')!.inert = !on;
    }
    const days = Array.from({ length: 7 }, (_, i) => iso(mondayOf(date) + i * DAY));
    root.querySelector('[data-week-label]')!.textContent = `${fmt(days[0], { day: 'numeric', month: 'short' })} – ${fmt(days[6], { day: 'numeric', month: 'short' })}`;
    root.querySelector<HTMLButtonElement>('[data-prev]')!.disabled = index <= 0;
    root.querySelector<HTMLButtonElement>('[data-next]')!.disabled = index >= cards.length - 1;
    root.querySelector<HTMLButtonElement>('[data-today]')!.disabled = date === todayIso();
    centre(smooth);
  }

  function move(by: number) {
    const cards = [...root.querySelectorAll<HTMLElement>('.day')];
    const next = cards[cards.findIndex((c) => c.dataset.date === activeDate) + by];
    if (next) setActive(next.dataset.date!);
  }

  function render() {
    // Keep focus and typed text in an open form when a live update comes in.
    const active = document.activeElement as HTMLInputElement | null;
    const typing = active?.closest('.add-form.inline') ? { date: active.closest<HTMLElement>('.day')?.dataset.date, value: active.value, name: active.name } : null;

    const dates = [...tasks.map((t) => t.date), ...events.map((e) => e.date), todayIso()];
    const first = Math.min(...dates.map(mondayOf));
    const last = Math.max(...dates.map(mondayOf));
    const shown: string[] = [];
    for (let t = first; t <= last + 6 * DAY; t += DAY) {
      const d = iso(t);
      // Skip empty days, but always show today.
      if (d === todayIso() || tasks.some((x) => x.date === d) || events.some((e) => e.date === d) || openForms.has(d)) shown.push(d);
    }
    if (!shown.includes(activeDate)) activeDate = todayIso();

    const navButton = (attr: string, label: string, text: string) => el('button', { type: 'button', class: 'nav-btn', [attr]: true, 'aria-label': label }, text);
    const prev = navButton('data-prev', 'Previous day', '↑');
    const next = navButton('data-next', 'Next day', '↓');
    const today = el('button', { type: 'button', class: 'pill ghost today-btn', 'data-today': true }, 'Today');
    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    today.addEventListener('click', () => setActive(todayIso()));

    const nextViewport = el('div', { class: 'carousel-viewport' }, el('ol', { class: 'days' }, ...shown.map(dayCard)));
    const carousel = el(
      'section',
      { class: 'carousel', 'aria-label': 'Days', 'aria-roledescription': 'carousel' },
      el('div', { class: 'carousel-head' }, el('h2', { 'data-week-label': true, 'aria-live': 'polite' }), el('div', { class: 'carousel-nav' }, prev, today, next)),
      nextViewport,
    );
    root.setAttribute('aria-busy', 'false');
    root.replaceChildren(carousel);
    viewport = nextViewport;
    setActive(activeDate, false);

    if (typing?.date) {
      const input = root.querySelector<HTMLInputElement>(`.day[data-date="${typing.date}"] .add-form [name="${typing.name}"]`);
      if (input) {
        input.value = typing.value;
        input.focus();
      }
    }
  }

  // Arrow keys move between days, except while typing.
  root.addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input, select, textarea')) return;
    if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') move(-1);
    else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') move(1);
    else return;
    e.preventDefault();
    root.querySelector<HTMLElement>('.day.is-active .day-toggle')?.focus({ preventScroll: true });
  });
  addEventListener('resize', () => centre(false));

  // Global form, for a day that is not on the calendar yet.
  (globalAdd.elements.namedItem('date') as HTMLInputElement).value = todayIso();
  globalAdd.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(globalAdd);
    const ok = await call('add_task_for', {
      task_date: f.get('date'),
      task_track: f.get('track'),
      task_title: String(f.get('title')),
      task_assignees: f.getAll('assignees'),
    });
    if (ok) {
      globalAdd.reset();
      (globalAdd.elements.namedItem('date') as HTMLInputElement).value = String(f.get('date'));
      setActive(String(f.get('date')));
    }
  });

  onAuthChange(() => {
    globalAdd.hidden = !canEdit();
    if (loaded) render();
  });
  load();
</script>

<style>
  h1 {
    margin: 0 0 0.5rem;
  }

  .intro {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 700;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 999px;
  }

  .dot {
    width: 0.65rem;
    height: 0.65rem;
    background: var(--tag-color);
    border-radius: 3px;
    transform: rotate(-8deg);
  }

  :global(.add-form) {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 1rem 1.1rem;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .add-title {
    margin: 0;
    font-weight: 800;
  }

  :global(.add-form .row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.add-form input),
  :global(.add-form select) {
    min-width: 0;
    padding: 0.4rem 0.6rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--bg);
    border: 2px solid var(--border);
    border-radius: 10px;
  }

  :global(.add-form input[name='title']) {
    flex: 1 1 14rem;
  }

  .message {
    margin: 0 0 1rem;
    font-weight: 700;
    color: var(--accent);
  }

  .loading {
    color: var(--muted);
  }

  /* ---------- the day carousel (built by the script): days stacked top to bottom, one open */
  [data-calendar] :global(.carousel-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }

  [data-calendar] :global(.carousel-head h2) {
    margin: 0;
    font-size: 1.6rem;
  }

  [data-calendar] :global(.carousel-nav) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  [data-calendar] :global(.nav-btn) {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    font: inherit;
    font-weight: 800;
    color: var(--ink);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 200ms, color 200ms;
  }

  [data-calendar] :global(.nav-btn:disabled),
  [data-calendar] :global(.today-btn:disabled) {
    opacity: 0.4;
    cursor: default;
  }

  @media (hover: hover) {
    [data-calendar] :global(.nav-btn:not(:disabled):hover) {
      color: var(--accent);
      border-color: var(--accent);
    }
  }

  /* A window onto the days that scrolls up and down; the open day stays in the middle. */
  [data-calendar] :global(.carousel-viewport) {
    position: relative;
    max-height: min(40rem, 72vh);
    margin: 0 -0.75rem;
    padding: 1.5rem 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    /* Days running off the top and bottom fade out softly. */
    mask-image: linear-gradient(to bottom, transparent, #000 2rem, #000 calc(100% - 2rem), transparent);
  }

  [data-calendar] :global(.carousel-viewport::-webkit-scrollbar) {
    display: none;
  }

  [data-calendar] :global(.days) {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-calendar] :global(.day) {
    overflow: hidden;
    background: var(--surface);
    border: 2px solid transparent;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    opacity: 0.8;
    transition:
      opacity 300ms ease,
      box-shadow 300ms ease;
  }

  [data-calendar] :global(.day.is-active) {
    opacity: 1;
    box-shadow: var(--shadow-lift);
  }

  [data-calendar] :global(.day.is-today) {
    border-color: var(--accent);
  }

  /* The header row of a day: the date and a few coloured squares. Clicking it opens the day. */
  [data-calendar] :global(.day-toggle) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.6rem 1.1rem;
    font: inherit;
    color: inherit;
    text-align: left;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  @media (hover: hover) {
    [data-calendar] :global(.day:not(.is-active) .day-toggle:hover .number) {
      color: var(--accent);
    }

    [data-calendar] :global(.day:not(.is-active):hover) {
      opacity: 1;
    }
  }

  [data-calendar] :global(.day-toggle:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
    border-radius: var(--radius);
  }

  [data-calendar] :global(.day.is-active .day-toggle) {
    cursor: default;
  }

  [data-calendar] :global(.peek) {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    transition: opacity 250ms ease;
  }

  /* An open day lists everything itself, so the squares go. */
  [data-calendar] :global(.day.is-active .peek) {
    opacity: 0;
  }

  [data-calendar] :global(.peek-dot) {
    min-width: 1.35rem;
    padding: 0 0.3rem;
    font-size: 0.7rem;
    font-weight: 800;
